# PEG environment template.
#
# Copy to .env.local and fill in real values there. .env.local is gitignored;
# this file is committed and must never contain a real secret.
#
# Variable names are read directly by the Genblaze SDK — do not rename them.

# --- GMI Cloud (image generation + editing) ------------------------- REQUIRED
# Used by GMICloudImageProvider. Also gates model discovery.
GMI_API_KEY=
# Optional override; leave blank for the SDK default.
GMI_BASE_URL=

# --- Bria (true canvas expansion) ----------------------------------- OPTIONAL
# Required only by Extend Canvas. Bria's dedicated /v2/image/edit/expand
# endpoint is not exposed by GMI Cloud, so this credential comes directly
# from Bria. The service can still generate other nodes when it is unset.
BRIA_API_TOKEN=

# --- Backblaze B2 (asset + manifest storage) ------------------------ REQUIRED
# Application key with read/write on the bucket below.
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
# e.g. us-west-004 — shown on the bucket's detail page in the B2 console.
B2_REGION=

# --- Google Gemini (Art Direct / Read Style nodes) ------------------- OPTIONAL
# Only needed once the chat-backed nodes are wired. Image generation works without it.
GEMINI_API_KEY=

# --- Clerk (authentication + organizations) ------------------------ REQUIRED
# From https://dashboard.clerk.com. Enable Organizations in the dashboard —
# a workspace is a Clerk org, and the brand kit belongs to it.
# In development Next.js can run keyless: Clerk generates dev keys on first boot
# and shows a "Claim your application" banner. Production needs real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keep sign-in inside the app rather than on Clerk's hosted pages. Read
# server-side by auth.protect(), so the ClerkProvider props alone are not enough.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Local wiring ----------------------------------------------------------
# Where the Next.js route handlers reach the Python Genblaze service.
PEG_SERVICE_URL=http://127.0.0.1:8010
